# =============================================================================
# Foundry / Forge — переменные окружения
# Скопируйте этот файл в .env и заполните своими значениями:
#   cp .env.example .env
# =============================================================================

# ---------------------------------------------------------------------------
# Сеть
# ---------------------------------------------------------------------------

# RPC-эндпоинт целевой сети
RPC_URL=http://127.0.0.1:8545

# Chain ID (31337 = anvil/hardhat, 1 = mainnet, 11155111 = sepolia)
CHAIN_ID=31337

# ---------------------------------------------------------------------------
# Деплоер
# ---------------------------------------------------------------------------

# Приватный ключ аккаунта-деплоера (без 0x)
# ⚠️  НИКОГДА не коммитьте реальный ключ в репозиторий!
DEPLOYER_PRIVATE_KEY=

# Публичный адрес деплоера (для справки)
DEPLOYER_ADDRESS=

# ---------------------------------------------------------------------------
# Адреса задеплоенных контрактов
# ---------------------------------------------------------------------------

# Реализация OlegToken (UUPS implementation)
IMPLEMENTATION_ADDRESS=

# UUPS-прокси OlegToken (основной адрес токена)
PROXY_ADDRESS=

# TokenFactory (EIP-1167 клон-фабрика)
FACTORY_ADDRESS=

# ---------------------------------------------------------------------------
# Параметры токена
# ---------------------------------------------------------------------------

# Адрес доверенного ERC2771-форвардера (оставьте пустым, чтобы отключить)
TRUSTED_FORWARDER=

# Максимальный supply для OlegTokenV2 (в wei, 0 = без ограничения)
TOKEN_CAP=1000000000000000000000000

# ---------------------------------------------------------------------------
# Верификация на Etherscan / Blockscout
# ---------------------------------------------------------------------------

ETHERSCAN_API_KEY=
VERIFIER_URL=https://api-sepolia.etherscan.io/api
